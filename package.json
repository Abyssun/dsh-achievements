{
  "name": "dsh-achievements",
  "version": "0.1.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abyssun/dsh-achievements.git"
  },
  "homepage": "https://github.com/Abyssun/dsh-achievements#readme",
  "bugs": {
    "url": "https://github.com/Abyssun/dsh-achievements/issues"
  },
  "description": "Personal achievements dashboard for DeepSeek Harness: a full-page profile (cumulative tokens, peak usage, longest task, longest/current streak) plus a Token activity view with a contribution heatmap. Built on the official session-projection seam.",
  "keywords": ["dsh", "deepseek-harness", "dsh-plugin", "dsh-plugins", "cordis", "token-usage", "token-stats", "dashboard", "profile", "heatmap", "achievements"],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./typert": "./typert.host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "typert.host.js",
    "cordis.patch.yml",
    "lib"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.1.5-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.2 || ^0.2.0-rc.1"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check typert.host.js && node --check lib/fold.js && node --check lib/metrics.js",
    "smoke:metrics": "node scripts/smoke-metrics.mjs",
    "smoke:host": "node scripts/smoke-host.mjs",
    "smoke:client": "node scripts/smoke-client.mjs",
    "smoke:typert": "node scripts/smoke-typert.mjs",
    "smoke:compat": "node scripts/smoke-compat.mjs",
    "smoke": "npm run smoke:compat && npm run smoke:metrics && npm run smoke:host && npm run smoke:client && npm run smoke:typert",
    "e2e": "npm run check && npm run smoke"
  }
}
